{
  "$schema": "../../scripts/generators/generate-crud.config.schema.json",
  "exclude": ["fgaConfig", "rsaSigningKeys", "userCredentials", "userMfaRecoveryCodes", "userOtpChallenges"],
  "schemaOnly": [
    "auditLog",
    "hardDeleteLog",
    "t4tAuditLogs",
    "authAuditLog",
    "userSessions",
    "userMfaTotp",
    "userFederatedIdentities",
    "userRoles"
  ],
  "tables": {
    "users": {
      "excludeFromBody": [
        "password",
        "salt",
        "gaKey",
        "refreshToken",
        "smsOtpPin",
        "smsVerified",
        "smsLastSent",
        "retryCount",
        "retryLimit",
        "retryReset",
        "revoked"
      ],
      "excludeFromResponse": ["password", "salt", "gaKey", "refreshToken", "smsOtpPin"]
    },
    "student": {
      "excludeFromBody": ["secret"],
      "excludeFromResponse": ["secret"]
    },
    "iamUsers": {
      "excludeFromBody": ["email_verified_at", "phone_verified_at", "deleted_at"],
      "excludeFromResponse": []
    },
    "roles": {
      "excludeFromBody": ["is_system"]
    }
  }
}
