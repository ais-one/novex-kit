  "description": "Merged A2A + MCP + RAG sample — supervisor (OpenAI) + specialist (OpenAI RAG) + MCP server",
  "type": "module",
  "scripts": {
    "start:mcp": "node --watch --watch-preserve-output --trace-warnings src/mcp/server.ts",
    "start:supervisor": "node src/a2a/supervisor.ts",
