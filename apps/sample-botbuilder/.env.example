# Copy this file to .env and fill in values

# Database
DRIZZLE_PG=postgresql://postgres:postgres@127.0.0.1:55432/db_express?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/db_express?sslmode=disable

# API Server Port
API_PORT=3101

# MCP Server Port
MCP_PORT=3100
MCP_SERVER_URL=http://localhost:3100/mcp

# OpenAI API Key (required for LLM + embeddings)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Telegram Bot Token
# Create bot via @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your-bot-token

# Webhook base URL (for ngrok: https://xxxx.ngrok-free.app)
# Run: npx ngrok http 3101
TELEGRAM_WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok-free.app

# OpenWeatherMap API Key (free tier, 1000 calls/day)
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-api-key
