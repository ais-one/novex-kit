{
  "name": "@apps/sample-common",
  "description": "Internal shared backend code for apps/* workspaces in this repository.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./*": "./*.ts"
  },
  "main": "index.ts",
  "scripts": {
    "create:app": "node create-app.js",
    "lint": "biome check --config-path ../../biome-node.json",
    "test:unit": "node --test-reporter=spec --experimental-test-coverage --experimental-test-module-mocks --test --test-only ./services/**/__tests__/unit/*.test.ts",
    "test:integration": "exit 0",
    "test:schema": "exit 0",
    "test": "npm run test:unit && npm run test:integration && npm run test:schema",
    "test:e2e": "start-server-and-test start http://localhost:8080 test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@db/rag": "file:../../db/rag",
    "@langchain/textsplitters": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "kafkajs": "^2.2.4",
    "knex": "^3.3.0",
    "mammoth": "^1.12.2",
    "openai": "^7.9.0",
    "pdf-parse": "^2.4.5",
    "pgvector": "^0.3.0"
  }
}
