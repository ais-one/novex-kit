{
  // IAM service config — stripped from sample-api to only IAM-relevant blocks
  "DRIZZLE_PG": {},
  "SERVICES_CONFIG": {
    "drizzle1": { "type": "drizzle", "options": "DRIZZLE_PG" },
    "keyv": { "type": "keyv", "options": "KEYV_CACHE" }
  },
  "KEYV_CACHE": {},
  "CORS_OPTIONS": {
    "methods": "GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS",
    "preflightContinue": false,
    "optionsSuccessStatus": 204,
    "credentials": true,
    "origin": ["http://127.0.0.1:8080", "https://127.0.0.1:8080"]
  },
  "RES_HEADERS_ADD": {},
  "HELMET_OPTIONS": null,
  "AUTH_ERROR_URL": "", // URL to redirect if error
  "COOKIE_OPTS": {
    "httpOnly": true,
    "sameSite": "lax",
    "secure": false,
    "maxAge": 0,
    "domain": ""
  },
  "BODYPARSER_JSON": { "limit": "2mb" },
  "BODYPARSER_URLENCODED": { "extended": true, "limit": "2mb" },
  "BODYPARSER_RAW_ROUTES": "",

  "JWT": {
    "USER_SERVICE_NAME": "drizzle1",
    "TOKEN_SERVICE_NAME": "keyv",
    "COOKIE_HTTPONLY": true,
    "JWT_ALG": "HS256",
    "JWT_EXPIRY_SEC": "45m",
    "JWT_REFRESH_EXPIRY_SEC": 3600,
    "JWT_REFRESH_STORE_TYPE": "keyv",
    "JWT_REFRESH_STORE_NAME": "user_session",
    "JWT_REFRESH_TOKEN_BYTE_LEN": 32,
    "JWT_ISS": "",
    "JWT_AUD": "",
    "JWT_SCOPE": "openid profile email"
  },

  "FGA_CONFIG": {
    "apiUrl": "http://127.0.0.1:8080",
    "storeId": "",
    "authorizationModelId": ""
  },

  "RBAC_CONFIG": {
    "enabled": false,
    "serviceName": "drizzle1"
  },

  "SAML_OPTIONS": {
    "idpCert": "<contents of idp-cert.pem>",
    "cert": "<contents of idp-cert.pem>",
    "callbackUrl": "http://127.0.0.1:3001/api/saml/callback",
    "entryPoint": "http://127.0.0.1:7000/saml/sso",
    "identifierFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress",
    "issuer": "http://127.0.0.1:3001",
    "wantAuthnResponseSigned": true,
    "wantAssertionsSigned": false,
    "signatureAlgorithm": "sha256"
  },
  "SAML_JWT_MAP": {
    "id": "nameID",
    "groups": "Role"
  },

  "OIDC_OPTIONS": {
    "URL": "http://127.0.0.1:4000",
    "CLIENT_ID": "my-app",
    "CLIENT_SECRET": "my-app-secret",
    "CALLBACK": "http://127.0.0.1:3001/api/auth/oidc/callback",
    "REISSUE": true,
    "ID_NAME": "sub"
  },

  "OAUTH_OPTIONS": {
    "URL": "https://github.com/login/oauth/access_token",
    "CLIENT_ID": "a355948a635c2a2066e2",
    "CLIENT_SECRET": "<REDACTED>",
    "CALLBACK": "http://127.0.0.1:3001/sso.html",
    "USER_URL": "https://api.github.com/user",
    "USER_ID": "id",
    "USER_GROUPS": "",
    "FIND_ID": "githubId"
  }
}
