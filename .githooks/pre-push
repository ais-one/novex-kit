#!/bin/sh
# .githooks/pre-push
# Pre-push hook: runs `test:unit` in every workspace that has it, then `tsc --noEmit -p` on every TS project, before allowing a push
# (integration and e2e tests run in CI / manually; schema tests run in pre-commit).
#
# Install: runs automatically on `npm install` (re-run: npm run prepare)
# Skip:    git push --no-verify

HOOK_NAME=pre-push
# shellcheck source=.githooks/_common.sh
. "$(dirname "$0")/_common.sh"

# ── 1. Unit Tests for every workspace ──────────────────────────────────────────────
TEST_EXIT=0
TESTED=0
for WS in apps/* common/compiled/* common/vanilla/* db/* scripts/*; do
  [ -f "$WS/package.json" ] || continue
  if node -e "const p=require('./${WS}/package.json'); process.exit(p.scripts&&p.scripts['test:unit']?0:1)" 2>/dev/null; then
    TESTED=$((TESTED + 1))
    print_info "Running unit tests for workspace: $WS"
    npm run test:unit --workspace="$WS"
    if [ $? -ne 0 ]; then
      print_error "Unit tests failed for workspace: $WS"
      TEST_EXIT=1
    else
      print_success "Unit tests passed for workspace: $WS"
    fi
  else
    print_info "Skipped $WS (no test:unit script, or package.json unreadable)"
  fi
done

if [ $TEST_EXIT -ne 0 ]; then
  print_error "Fix failing tests before pushing. Use 'git push --no-verify' to bypass."
  exit 1
fi

if [ $TESTED -eq 0 ]; then
  print_warning "No workspace has a test:unit script - no unit tests were run."
else
  print_success "Unit tests passed in $TESTED workspace(s)."
fi

# ── 2. Type checking tsc --noEmit ────────────────────────────────────────────
# One run per TS project: each app's own tsconfig, plus the shared group
# tsconfigs for common/, db/ and scripts/ (see .claude/CLAUDE.md - TypeScript configuration).
TYPE_EXIT=0
TYPECHECKED=0
for PROJ in apps/* common db scripts; do
  [ -f "$PROJ/tsconfig.json" ] || continue
  TYPECHECKED=$((TYPECHECKED + 1))
  print_info "Type checking project: $PROJ"
  npx --no-install tsc --noEmit -p "$PROJ"
  if [ $? -ne 0 ]; then
    print_error "Type check failed for project: $PROJ"
    TYPE_EXIT=1
  else
    print_success "Type check passed for project: $PROJ"
  fi
done

if [ $TYPE_EXIT -ne 0 ]; then
  print_error "Fix type errors before pushing. Use 'git push --no-verify' to bypass."
  exit 1
fi

if [ $TYPECHECKED -eq 0 ]; then
  print_warning "No tsconfig.json found - no type checking was run."
else
  print_success "Type check passed in $TYPECHECKED project(s)."
fi

# ── 3. Security audit ────────────────────────────────────────────────────────
# Run This In CI only

# ── Done ─────────────────────────────────────────────────────────────────────
print_success "All pre-push checks passed. Proceeding with push."
exit 0
