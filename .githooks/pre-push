#!/bin/sh
# .githooks/pre-push
# Pre-push hook: runs workspace tests (unit + integration, no e2e) and schema validation tests before allowing a push.
#
# Install: runs automatically on `npm install` (re-run: npm run prepare)
# Skip:    git push --no-verify

HOOK_NAME=pre-push
# shellcheck source=.githooks/_common.sh
. "$(dirname "$0")/_common.sh"

# ── 1. Tests for every workspace ──────────────────────────────────────────────
# Runs each workspace's `test` script (unit + integration; no e2e), touched or not.
# TODO: e2e tests disabled for now - to re-enable, also run `test:e2e` per workspace below.
TEST_EXIT=0
for WS in apps/* common/compiled/* common/vanilla/* db/* scripts/*; do
  [ -f "$WS/package.json" ] || continue
  if node -e "const p=require('./${WS}/package.json'); process.exit(p.scripts&&p.scripts['test']?0:1)" 2>/dev/null; then
    print_info "Running tests for workspace: $WS"
    npm run test --workspace="$WS"
    if [ $? -ne 0 ]; then
      print_error "Tests failed for workspace: $WS"
      TEST_EXIT=1
    else
      print_success "Tests passed for workspace: $WS"
    fi
  fi
done

if [ $TEST_EXIT -ne 0 ]; then
  print_error "Fix failing tests before pushing. Use 'git push --no-verify' to bypass."
  exit 1
fi

print_success "Workspace tests passed."

# ── 2. Type checking tsc --noEmit ────────────────────────────────────────────

# ── 3. Security audit ────────────────────────────────────────────────────────
# Run This In CI only

# ── Done ─────────────────────────────────────────────────────────────────────
print_success "All pre-push checks passed. Proceeding with push."
exit 0
