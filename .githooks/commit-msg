#!/bin/sh
# .githooks/commit-msg
# Validates the commit message against the Conventional Commits spec.
# Tip: use `npx czg` to compose a properly-formatted message interactively.
#
# Install: runs automatically on `npm install` (re-run: npm run prepare)
# Skip:    git commit --no-verify

HOOK_NAME=commit-msg
# shellcheck source=.githooks/_common.sh
. "$(dirname "$0")/_common.sh"

COMMIT_MSG_FILE="$1"

# Only the subject line is checked - the same line CI's commit lint (git log %s)
# and git-cliff read. Subject = first non-empty, non-comment line (git may still
# include '#' comment lines and leading blank lines at this point).
SUBJECT=$(grep -v '^#' "$COMMIT_MSG_FILE" | sed '/^[[:space:]]*$/d' | head -n 1)

# Skip git-generated merge, fixup and squash commits (same list as CI's commit lint).
# Reverts are NOT skipped: git's default 'Revert "..."' must be reworded to
# 'chore: revert ...', or CI rejects it and git-cliff drops it from release notes.
case "$SUBJECT" in
  Merge\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

# Conventional Commits pattern: type(scope?)[!]: description (same as CI)
PATTERN='^(feat|fix|hotfix|chore)(\([^)]+\))?!?: .{1,}$'

if ! printf '%s\n' "$SUBJECT" | grep -Eq "$PATTERN"; then
  print_error "Commit message subject does not follow Conventional Commits format."
  print_error "  Got:      $SUBJECT"
  print_info  "  Expected: type(scope): description"
  print_info  "  Types:    feat|fix|hotfix|chore"
  print_info  "  Note:     use chore for docs|style|refactor|perf|test|build|ci|revert changes"
  print_info  "  Tip:      use 'npx czg' to generate a valid message interactively."
  exit 1
fi

print_success "Commit message format OK."
exit 0
