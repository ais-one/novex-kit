#!/bin/sh
# .githooks/pre-commit
# Pre-commit hook: scans staged changes for secrets (gitleaks), runs Biome
# checks per-directory for staged files, and zod schema tests when schema
# files are staged.
#
# Install: runs automatically on `npm install` (re-run: npm run prepare)
# Skip:    git commit --no-verify

HOOK_NAME=pre-commit
# shellcheck source=.githooks/_common.sh
. "$(dirname "$0")/_common.sh"

# ── Collect all staged files ─────────────────────────────────────────────────
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

# ── 1. Secret scan (gitleaks) ────────────────────────────────────────────────
# Blocks the commit if the staged changes contain a secret - once pushed, a
# secret can't be fully removed from GitHub, only rotated.
# gitleaks is a standalone binary (not an npm package): brew install gitleaks
# Missing binary = warning only, so a fresh clone can still commit; CI (Quality
# workflow) and GitHub push protection are the later safety nets.
# False positive: add `gitleaks:allow` in a comment on that line, or add the
# finding's fingerprint to .gitleaksignore.
if [ -n "$STAGED" ]; then
  if command -v gitleaks >/dev/null 2>&1; then
    print_info "Scanning staged changes for secrets (gitleaks)…"
    if ! gitleaks git --pre-commit --staged --redact --no-banner --verbose; then
      print_error "gitleaks found a potential secret in the staged changes (see above)."
      print_error "Remove it, unstage it, or mark a false positive with 'gitleaks:allow'."
      exit 1
    fi
    print_success "No secrets found ✓"
  else
    print_warning "gitleaks not installed - secret scan skipped. Install: brew install gitleaks"
  fi
fi

# ── 2. Biome check per directory ─────────────────────────────────────────────
print_info "Running Biome checks on staged directories…"

BIOME_FAILED=0

run_biome_check() {
  DIR="$1"
  print_info "  npx biome check $DIR"
  npx biome check "$DIR"
  if [ $? -ne 0 ]; then
    print_error "Biome check failed for $DIR. Run 'npm run check:write' to auto-fix, then re-stage."
    BIOME_FAILED=1
  else
    print_success "  $DIR ✓"
  fi
}

echo "$STAGED" | grep -q '^common/vanilla/iso/'    && run_biome_check common/vanilla/iso
echo "$STAGED" | grep -q '^common/compiled/node/'  && run_biome_check common/compiled/node
echo "$STAGED" | grep -q '^common/compiled/vue/'   && run_biome_check common/compiled/vue
echo "$STAGED" | grep -q '^common/vanilla/web/'    && run_biome_check common/vanilla/web
echo "$STAGED" | grep -q '^apps/'         && run_biome_check apps
echo "$STAGED" | grep -q '^scripts/'      && run_biome_check scripts

if [ $BIOME_FAILED -ne 0 ]; then
  exit 1
fi

# ── 3. Schema (Zod) validation tests ─────────────────────────────────────────
# Detect staged files under the known schema folders:
#   common/schemas, apps/*/schemas
SCHEMA_FAILED=0

run_schema_tests() {
  SCHEMA_DIR="$1"
  if node -e "const p=require('./package.json'); process.exit(p.scripts&&p.scripts['test:schemas']?0:1)" 2>/dev/null; then
    print_info "Running schema validation tests for $SCHEMA_DIR…"
    npm run test:schemas -- "$SCHEMA_DIR"
    if [ $? -ne 0 ]; then
      print_error "Schema validation tests failed for $SCHEMA_DIR."
      return 1
    fi
    print_success "Schema validation tests passed for $SCHEMA_DIR."
  else
    print_warning "No 'test:schemas' script found – skipping schema tests for $SCHEMA_DIR."
  fi
  return 0
}

# Check common/schemas
if echo "$STAGED" | grep -q '^common/schemas/'; then
  run_schema_tests common/schemas || SCHEMA_FAILED=1
fi

# Check apps/*/schemas (one call per matching app directory)
APP_SCHEMA_DIRS=$(echo "$STAGED" | grep -oE '^apps/[^/]+/schemas/' | sed 's|/$||' | sort -u)
for SCHEMA_DIR in $APP_SCHEMA_DIRS; do
  run_schema_tests "$SCHEMA_DIR" || SCHEMA_FAILED=1
done

if [ $SCHEMA_FAILED -ne 0 ]; then
  exit 1
fi

# Report skip only when no schema folders were matched at all
echo "$STAGED" | grep -qE '^common/schemas/|^apps/[^/]+/schemas/' \
  || print_info "No schema files staged – skipping schema tests."

# ── Done ──────────────────────────────────────────────────────────────────────
print_success "All pre-commit checks passed."
exit 0
